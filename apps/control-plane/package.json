{
  "name": "@code-harness/control-plane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Thin BoardUI-style console over the multi-agent orchestrator. Renders HarnessEvents only; owns no orchestration logic.",
  "scripts": {
    "dev": "concurrently -k -n server,ui \"node server/server.mjs --mock --port 8787\" \"vite\"",
    "dev:server": "node server/server.mjs --mock --port 8787",
    "dev:server:live": "node server/server.mjs --port 8787",
    "build": "vite build",
    "start": "node server/server.mjs --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
