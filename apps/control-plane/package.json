{
  "name": "@code-harness/control-plane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React task board with an automatic local Codex queue, independent verification, conversational rework, and human approval.",
  "scripts": {
    "dev": "concurrently -k -n server,ui \"node server/server.mjs --port 8787\" \"vite\"",
    "dev:server": "node server/server.mjs --port 8787",
    "dev:server:live": "node server/server.mjs --port 8787",
    "build": "vite build",
    "start": "node server/server.mjs --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "motion": "^12.42.2",
    "react": "^19.2.4",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
